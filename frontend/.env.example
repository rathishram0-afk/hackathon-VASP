# Copy to .env.local and fill in real values. Never commit .env.local.

# FastAPI backend base URL.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable/anon key (safe to expose to the browser -- this is
# NOT the secret key). Find it in Supabase Dashboard -> Project Settings ->
# API -> Publishable key (or the legacy "anon" key).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
