# Copy to .env and fill in real values. Never commit .env.
#
# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Supabase "secret key" (service-role-equivalent, server-side only).
# Find it in Supabase Dashboard -> Project Settings -> API -> Secret keys.
# Grants full database access -- never expose this to the frontend, never
# commit it. The frontend only ever sends its own user's access token
# (Authorization: Bearer <supabase_access_token>), never this key.
SUPABASE_SECRET_KEY=
